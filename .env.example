SP_DB_PATH=support_pilot.db

# Answers: "replay" (offline demo), "anthropic" (Claude API), or "foundry" (Claude on Microsoft Foundry)
SP_LLM_PROVIDER=replay
SP_MODEL=claude-opus-5-5
SP_RECORD=false

# Sign-in: demo (default) | oidc (Microsoft Entra ID or any OIDC provider)
SP_AUTH=demo
# SP_OIDC_METADATA_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# SP_OIDC_CLIENT_ID=
# SP_OIDC_CLIENT_SECRET=
# SP_SESSION_SECRET=
# SP_APPROVER_ROLE=SupportPilot.Approver   # support leads

# Mission Control: send problems to Backlog Pilot's intake inbox (same token as BP_SUITE_TOKEN)
# SP_BACKLOG_URL=http://127.0.0.1:8000
# SP_LEADERSHIP_URL=http://127.0.0.1:8010
# SP_SUITE_TOKEN=
# SP_PUBLIC_URL=http://127.0.0.1:8030
# MISSION_CONTROL_APPS=Backlog Pilot=http://127.0.0.1:8000, Leadership Pilot=http://127.0.0.1:8010, PLM Insight=http://127.0.0.1:8020, Support Pilot=http://127.0.0.1:8030
